# Copy this file to .streamlit/secrets.toml for local development
# (secrets.toml itself is gitignored — never commit real credentials).
#
# On Streamlit Community Cloud, paste these same two lines into
# your app's "Settings -> Secrets" instead of committing this file.

SPOTIFY_CLIENT_ID = "your_client_id"
SPOTIFY_CLIENT_SECRET = "your_client_secret"
